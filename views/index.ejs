<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/site-layout') %>

    <main class="page-shell">
      <section class="hero-card">
        <div class="hero-intro">
          <div>
            <p class="hero-badge">منصة أجير الرقمية</p>
            <h2>إدارة تصاريح العمل ومتابعة المستخدمين</h2>
            <p>أدخل البيانات بالعربية والإنجليزية، ثم أنشئ رمز QR لكل مستخدم لعرض تفاصيل التصريح مباشرة عند المسح.</p>
            <div class="hero-cta-row">
              <a class="primary" href="/users/new">إضافة مستخدم جديد</a>
              <a class="secondary" href="/">الصفحة الرئيسية</a>
            </div>
          </div>
          <div class="hero-panel">
            <div class="hero-stat">
              <strong>سهل وسريع</strong>
              <span>إدارة المستخدمين وتوليد QR في خطوة واحدة</span>
            </div>
            <div class="hero-stat">
              <strong>متوافق مع التصريح</strong>
              <span>عرض بيانات المستخدم بصيغة جدول واضحة ومقسمة</span>
            </div>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="section-head">
          <h2>المستخدمون المسجلون</h2>
          <span><%= users.length %> عنصر</span>
        </div>

        <% if (users.length === 0) { %>
          <p class="empty-state">لا توجد سجلات بعد. أضف أول مستخدم جديد.</p>
        <% } else { %>
          <div class="user-list">
            <% users.forEach((user) => { %>
              <article class="user-item">
                <div>
                  <strong><%= user.permitNumberAr || '—' %></strong>
                  <p><%= user.workerNameAr || '—' %></p>
                </div>
                <a href="/usersqr/<%= user.id %>">عرض التفاصيل</a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>

    <%- include('partials/site-footer') %>
  </body>
</html>
