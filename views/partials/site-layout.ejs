<!-- Ensure document language and direction are set for browser translate detection -->
<script>
  (function(){
    var locale = "<%= typeof locale !== 'undefined' ? locale : 'ar' %>";
    try {
      if (document && document.documentElement) {
        if (document.documentElement.lang !== locale) document.documentElement.lang = locale;
        var dir = locale === 'ar' ? 'rtl' : 'ltr';
        if (document.documentElement.dir !== dir) document.documentElement.dir = dir;
      }
    } catch (e) {}
  })();
</script>

